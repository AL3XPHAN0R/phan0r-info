<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{% if title %}{{ title }} — {% endif %}{{ site.title }}</title>
  <meta name="description" content="{{ description or site.description }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Lora:wght@500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/assets/css/style.css">
  <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/atom.xml">
  <script src="https://www.google.com/recaptcha/api.js?hl=fr" async defer></script>
  <script>
    (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[]).push(arguments);},l=d.createElement(e),l.async=1,l.src=u,n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})(window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
    ml('account', '2359319');
  </script>
</head>
<body>
  <header>
    <a href="/" class="site-name">{{ site.author }}</a>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer>
    <div class="footer-links">
      <a href="{{ site.linkedin }}" target="_blank" rel="noopener">LinkedIn</a>
      <a href="/atom.xml">RSS</a>
    </div>
    <p class="copyright">© {{ "" | year }} {{ site.author }}</p>
  </footer>
</body>
</html>
